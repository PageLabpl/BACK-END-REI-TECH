# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o arquivo ".env" para o GitHub ou compartilhe publicamente.

PORT=3001

# URL pública onde o backend vai ficar hospedado (Render/Railway te dá essa URL)
PUBLIC_BASE_URL=http://localhost:3001

# URL do seu site (frontend) — usada no CORS e nos links de retorno do Mercado Pago
FRONTEND_URL=http://localhost:5500

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_uma_string_aleatoria_grande_e_unica

# Gere com: npm run hash-password -- "SuaSenhaForte123"
ADMIN_PASSWORD_HASH=

# Pegue no seu painel do Mercado Pago Developers (Credenciais de Produção)
MP_ACCESS_TOKEN=

# Pegue em cloudinary.com (Dashboard) — usado para guardar as fotos dos produtos
# de forma permanente (o disco do Render é apagado a cada deploy/restart)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Login "Continuar com Google" dos clientes. Pegue em console.cloud.google.com
# -> APIs e serviços -> Credenciais -> ID do cliente OAuth 2.0 (tipo "Aplicativo
# da Web"). Cole o mesmo valor aqui E na constante GOOGLE_CLIENT_ID lá no
# index.html (não é segredo, mas o backend também precisa dele pra confirmar
# com o Google que o login é válido). Sem essa variável, o botão do Google
# simplesmente não aparece — o resto do login continua funcionando normal.
GOOGLE_CLIENT_ID=

# Pegue em supabase.com -> seu projeto -> Project Settings -> API
# ESSENCIAL em produção: sem isso, tudo que for cadastrado (produtos, fotos,
# pedidos, contas) é apagado a cada deploy/restart no Render.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# ATENÇÃO: use a "service_role" key (não a "anon" key) — ela fica só no
# backend e NUNCA deve ser exposta no frontend/index.html.
SUPABASE_SERVICE_KEY=

# Pegue em resend.com (Dashboard -> API Keys) — usado para enviar o e-mail
# de confirmação de venda pro cliente quando o pagamento é aprovado.
RESEND_API_KEY=
# Precisa ser um e-mail de um domínio verificado no Resend (Dashboard ->
# Domains). Sem domínio verificado, o Resend só permite enviar pro seu
# próprio e-mail de cadastro (modo sandbox), não pros seus clientes.
RESEND_FROM_EMAIL=pedidos@seudominio.com
STORE_NAME=REI TECH
